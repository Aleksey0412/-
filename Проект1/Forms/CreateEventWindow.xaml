<Window x:Class="Проект1.Forms.CreateEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создание мероприятия" Height="400" Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Новое мероприятие" FontSize="20" FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <!-- Название -->
        <TextBlock Grid.Row="1" Text="Название:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" x:Name="txtName" Margin="0,0,0,15"/>

        <!-- Направление -->
        <TextBlock Grid.Row="3" Text="Направление:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="4" x:Name="cmbDirection" Margin="0,0,0,15" IsEditable="True"/>

        <!-- Город -->
        <TextBlock Grid.Row="5" Text="Город:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="6" x:Name="cmbCity" Margin="0,0,0,15" IsEditable="True"/>

        <!-- Дата начала -->
        <TextBlock Grid.Row="7" Text="Дата и время начала:" Margin="0,0,0,5"/>
        <DatePicker Grid.Row="8" x:Name="dpStart" Margin="0,0,0,15"/>

        <!-- Кнопки -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Создать" Click="btnCreate_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="Отмена" Click="btnCancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>