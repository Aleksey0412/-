<Window x:Class="Проект1.Forms.OrganizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Окно организатора" 
        Height="450" Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="txtGreeting" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtTime" FontSize="14" Foreground="Gray" Margin="0,0,0,20"/>

            <Button Content="Назад" Click="btnBack_Click"  Width="100" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>