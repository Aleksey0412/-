<Window x:Class="Проект1.Forms.EventDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация о мероприятии" Height="400" Width="500">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="txtName" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtDirection" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtCity" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtDate" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtTime" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtDescription" Margin="0,20,0,0" TextWrapping="Wrap"/>

            <Button Content="Назад" Click="btnBack_Click" Width="100" 
                    HorizontalAlignment="Left" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</Window>