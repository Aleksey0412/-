<Window x:Class="Проект1.Forms.ParticipantsViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Участники" Height="450" Width="600">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Участники мероприятий" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <DataGrid Grid.Row="1" x:Name="dgParticipants" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Зарегистрировать" Click="btnRegister_Click" Width="130" Margin="0,0,10,0"/>
            <Button Content="Назад" Click="btnBack_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>