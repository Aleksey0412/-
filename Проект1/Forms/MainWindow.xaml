<Window x:Class="Проект1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система конференций" 
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и фильтры -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Мероприятия" FontSize="24" FontWeight="Bold" Margin="0,0,0,15"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Направление:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbDirection" Width="150" Margin="0,0,10,0"/>

                <TextBlock Text="Дата:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <DatePicker x:Name="dpDate" Width="120" Margin="0,0,10,0"/>

                <Button Content="Фильтр" Click="btnFilter_Click"  Width="70" Margin="0,0,5,0"/>
                <Button Content="Сброс" Click="btnReset_Click"  Width="70"/>
            </StackPanel>
        </StackPanel>

        <!-- Таблица мероприятий -->
        <DataGrid Grid.Row="1" x:Name="dgEvents" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding EventName}" Width="*"/>
                <DataGridTextColumn Header="Направление" Binding="{Binding Direction}" Width="150"/>
                <DataGridTextColumn Header="Город" Binding="{Binding City}" Width="120"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding StartDateTime, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Время" Binding="{Binding StartDateTime, StringFormat={}{0:HH:mm}}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Авторизация" Click="btnLogin_Click" Width="120" Margin="0,0,10,0"/>
            <Button Content="Подробно" Click="btnDetails_Click" Width="120"/>
        </StackPanel>
    </Grid>
</Window>