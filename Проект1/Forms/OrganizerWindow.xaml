<Window x:Class="Проект1.Forms.OrganizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Окно организатора" Height="350" Width="600"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Приветствие -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock x:Name="txtGreeting" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="txtTime" FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBlock Text="Управление" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <WrapPanel Orientation="Horizontal">
                <Button Content="Создать мероприятие" Click="btnCreateEvent_Click" 
                        Width="150" Height="40" Margin="0,0,10,10"/>
                <Button Content="Мероприятия" Click="btnEvents_Click" 
                        Width="150" Height="40" Margin="0,0,10,10"/>
                <Button Content="Kanban доска" Click="btnKanban_Click" 
                        Width="150" Height="40" Margin="0,0,10,10"/>
                <Button Content="Участники" Click="btnParticipants_Click" 
                        Width="150" Height="40" Margin="0,0,10,10"/>
                <Button Content="Жюри и модераторы" Click="btnJuryModerators_Click" 
                        Width="150" Height="40" Margin="0,0,10,10"/>
                <Button Content="Регистрация" Click="btnRegister_Click" 
                        Width="150" Height="40" Margin="0,0,10,10"/>
            </WrapPanel>
        </StackPanel>

        <!-- Кнопка Назад -->
        <Button Grid.Row="3" Content="Назад" Click="btnBack_Click" 
                Width="100" HorizontalAlignment="Left" Margin="10"/>
    </Grid>
</Window>