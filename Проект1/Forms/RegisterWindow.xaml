<Window x:Class="Проект1.Forms.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="380" Width="450">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Регистрация" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="ФИО:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" x:Name="txtFullName" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="3" Text="Роль:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="4" x:Name="cmbRole" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="5" Text="Email:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="6" x:Name="txtEmail" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Зарегистрировать" Click="btnRegister_Click" Width="130" Margin="0,0,10,0"/>
            <Button Content="Отмена" Click="btnCancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>