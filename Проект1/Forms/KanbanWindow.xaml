<Window x:Class="Проект1.Forms.KanbanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kanban доска" Height="500" Width="700">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Активности мероприятия" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ListBox Grid.Row="1" x:Name="lbActivities" DisplayMemberPath="ActivityName" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Задачи" Click="btnTasks_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="Назад" Click="btnBack_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>