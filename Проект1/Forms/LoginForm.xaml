<Window x:Class="Проект1.Forms.LoginForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" 
        Height="310" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Вход в систему" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Id Number:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" x:Name="txtIdNumber" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="3" Text="Пароль:" Margin="0,0,0,5"/>
        <PasswordBox Grid.Row="4" x:Name="txtPassword" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock x:Name="txtCaptcha" Text="ABCD" FontSize="24" FontWeight="Bold" 
                       Foreground="DarkBlue" FontFamily="Courier New" 
                       Margin="0,0,10,0" Width="100" TextAlignment="Center"/>
            <TextBox x:Name="txtCaptchaInput" Width="80" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Войти" Click="btnLogin_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="Отмена" Click="btnCancel_Click" Width="100"/>
        </StackPanel>
    </Grid>
</Window>