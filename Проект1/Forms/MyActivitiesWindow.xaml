<Window x:Class="Проект1.Forms.MyActivitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои активности" Height="450" Width="600">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Мои активности" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ListBox Grid.Row="1" x:Name="lbActivities" DisplayMemberPath="ActivityName"/>

        <Button Grid.Row="2" Content="Назад" Click="btnBack_Click" Width="100" 
                HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </Grid>
</Window>